# Frontend (Vite) — safe to expose in the browser bundle.
# Copy this file to `.env` and fill in the values from your Supabase project:
#   Supabase Dashboard → Project Settings → API
VITE_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key

# NOTE: The Gemini API key is NOT stored here. It is a server-side secret set on
# the Supabase Edge Function so it never reaches the browser:
#   npx supabase secrets set GEMINI_API_KEY=your-key
